# Face Recognition API - STAGING Environment
# ==========================================

# Environment
ENV=staging

# Server
DEBUG=True
HOST=0.0.0.0
PORT=5000

# API Security (use different token for staging)
ACCESS_TOKEN=   
MAX_UPLOAD_SIZE=10485760
RATE_LIMIT=100 per minute

# Database (Dynamic based on engine)
# DB_PATH=data/staging.db

# Face Recognition Engine
# Supported: opencv (default), insightface
FACE_ENGINE=insightface
FACE_TOLERANCE=0.363

# InsightFace options (only when FACE_ENGINE=insightface)
INSIGHTFACE_MODEL=buffalo_l

# Anti-Spoofing / Liveness Detection
ANTI_SPOOFING=true
ANTI_SPOOFING_THRESHOLD=0.5

# Pagination
ITEMS_PER_PAGE=10
