# Face Recognition API - STAGING Environment
# ==========================================

# Environment
ENV=staging

# Server
DEBUG=True
HOST=0.0.0.0
PORT=5000

# API Security (use different token for staging)
ACCESS_TOKEN=staging-token-12345
MAX_UPLOAD_SIZE=10485760
RATE_LIMIT=100 per minute

# Database (Staging - separate from production!)
DB_PATH=data/staging.db

# Face Recognition
FACE_TOLERANCE=0.363

# Pagination
ITEMS_PER_PAGE=10
