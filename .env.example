# Face Recognition API - Environment Configuration
# ================================================
# 
# HOW TO USE:
# 1. Copy .env.staging or .env.production to configure
# 2. Set environment: set ENV=staging or set ENV=production
# 3. Run: python run.py
#
# Files:
#   .env.staging    → Uses data/staging.db
#   .env.production → Uses data/production.db

# Environment (staging or production)
ENV=staging

# Server
DEBUG=True
HOST=0.0.0.0
PORT=5000

# API Security
ACCESS_TOKEN=your-secret-token-here
MAX_UPLOAD_SIZE=10485760
RATE_LIMIT=100 per minute

# Database (SQLite) - Auto-set per environment
# Staging:    data/staging.db
# Production: data/production.db
DB_PATH=data/staging.db

# Face Recognition Engine
# Supported: opencv (default), insightface
FACE_ENGINE=opencv
FACE_TOLERANCE=0.363

# InsightFace options (only used when FACE_ENGINE=insightface)
# Models: buffalo_l, buffalo_s, buffalo_sc
INSIGHTFACE_MODEL=buffalo_l

# Anti-Spoofing / Liveness Detection
# Set to 'true' to auto-check during /register and /verify
# Also used as texture check during challenge-response liveness
ANTI_SPOOFING=false
# Liveness score threshold (0.0-1.0, higher = stricter)
ANTI_SPOOFING_THRESHOLD=0.5

# Challenge-Response Liveness Detection
# Number of random challenges per session (+ look_straight baseline = total)
LIVENESS_CHALLENGE_COUNT=3
# How many frames the client should send per challenge (3-5 recommended)
LIVENESS_FRAMES_PER_CHALLENGE=3
# Fraction of frames that must pass for a challenge to succeed (0.0-1.0)
LIVENESS_CONSENSUS_THRESHOLD=0.6
# Session timeout in seconds
LIVENESS_SESSION_TIMEOUT=120

# Pagination
ITEMS_PER_PAGE=10
