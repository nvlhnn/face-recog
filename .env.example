# Face Recognition API - Environment Configuration
# ================================================
# 
# HOW TO USE:
# 1. Copy .env.staging or .env.production to configure
# 2. Set environment: set ENV=staging or set ENV=production
# 3. Run: python run.py
#
# Files:
#   .env.staging    → Uses data/staging.db
#   .env.production → Uses data/production.db

# Environment (staging or production)
ENV=staging

# Server
DEBUG=True
HOST=0.0.0.0
PORT=5000

# API Security
ACCESS_TOKEN=your-secret-token-here
MAX_UPLOAD_SIZE=10485760
RATE_LIMIT=100 per minute

# Database (SQLite) - Auto-set per environment
# Staging:    data/staging.db
# Production: data/production.db
DB_PATH=data/staging.db

# Face Recognition (OpenCV + SFace)
FACE_TOLERANCE=0.363

# Pagination
ITEMS_PER_PAGE=10
