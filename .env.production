# Face Recognition API - PRODUCTION Environment
# =============================================

# Environment
ENV=production

# Server
DEBUG=False
HOST=0.0.0.0
PORT=5000

# API Security (use strong token for production!)
ACCESS_TOKEN=your-secure-production-token-here
MAX_UPLOAD_SIZE=10485760
RATE_LIMIT=100 per minute

# Database (Production - keep separate from staging!)
DB_PATH=data/production.db

# Face Recognition
FACE_TOLERANCE=0.363

# Pagination
ITEMS_PER_PAGE=10
