# Face Recognition API - PRODUCTION Environment
# =============================================

# Environment
ENV=production

# Server
DEBUG=False
HOST=0.0.0.0
PORT=5000

# API Security (use strong token for production!)
ACCESS_TOKEN=your-secure-production-token-here
MAX_UPLOAD_SIZE=10485760
RATE_LIMIT=100 per minute

# Database (Dynamic based on engine)
# DB_PATH=data/production.db

# Face Recognition Engine
# Supported: opencv (default), insightface
FACE_ENGINE=insightface
FACE_TOLERANCE=0.363

# InsightFace options (only when FACE_ENGINE=insightface)
INSIGHTFACE_MODEL=buffalo_l

# Anti-Spoofing / Liveness Detection
ANTI_SPOOFING=true
ANTI_SPOOFING_THRESHOLD=0.5

# Challenge-Response Liveness
LIVENESS_CHALLENGE_COUNT=3
LIVENESS_FRAMES_PER_CHALLENGE=3
LIVENESS_CONSENSUS_THRESHOLD=0.6
LIVENESS_SESSION_TIMEOUT=120

# Pagination
ITEMS_PER_PAGE=10
